#!/bin/sh
set -eu

if [ "$#" -ne 2 ]; then
  echo "usage: domus-preview INPUT OUTPUT" >&2
  exit 64
fi

input=$1
output=$2
case "$input" in /workspace/*) ;; *) echo "input must be inside /workspace" >&2; exit 64 ;; esac
case "$output" in /workspace/*) ;; *) echo "output must be inside /workspace" >&2; exit 64 ;; esac
if [ "$input" = "$output" ]; then
  echo "input and output must differ" >&2
  exit 64
fi

mime=$(file --brief --mime-type -- "$input")
case "$mime" in
  image/*)
    if command -v magick >/dev/null 2>&1; then
      exec magick "${input}[0]" -auto-orient -thumbnail '1600x1600>' -strip -quality 82 "$output"
    fi
    exec convert "${input}[0]" -auto-orient -thumbnail '1600x1600>' -strip -quality 82 "$output"
    ;;
  video/*)
    exec ffmpeg -nostdin -hide_banner -loglevel error -y -ss 1 -i "$input" \
      -frames:v 1 -vf "scale='min(1600,iw)':-2" "$output"
    ;;
  application/pdf)
    output_base=${output%.jpg}
    exec pdftoppm -f 1 -l 1 -singlefile -jpeg -scale-to 1600 -- "$input" "$output_base"
    ;;
  *)
    echo "unsupported preview MIME type: $mime" >&2
    exit 65
    ;;
esac
