[Unit]
Description=Domus web control plane
Documentation=file:///usr/share/doc/domus/dofs-production.md
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/domus/config.yaml

[Service]
Type=simple
User=domus
Group=domus
UMask=0077
StateDirectory=domus
StateDirectoryMode=0700
WorkingDirectory=/var/lib/domus
ExecStart=/usr/local/bin/domus start -c /etc/domus/config.yaml
Restart=on-failure
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=30s
KillSignal=SIGTERM
KillMode=mixed
LimitNOFILE=1048576
LimitCORE=0

# This process needs PostgreSQL/OSS networking. It does not need /dev/fuse or
# the host mount namespace; the optional DOFS FUSE service is independent.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
